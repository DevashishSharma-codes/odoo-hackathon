generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model activities {
  id               Int               @id @default(autoincrement()) @db.UnsignedInt
  city_id          Int               @db.UnsignedInt
  name             String            @db.VarChar(150)
  description      String?           @db.Text
  category         String            @db.VarChar(60)
  estimated_cost   Decimal           @default(0.00) @db.Decimal(10, 2)
  duration_minutes Int               @default(60) @db.SmallInt
  image_url        String?           @db.VarChar(500)
  created_at       DateTime          @default(now()) @db.Timestamp(0)
  cities           cities            @relation(fields: [city_id], references: [id], onDelete: Cascade, map: "fk_activities_city")
  stop_activities  stop_activities[]

  @@index([category], map: "idx_activities_category")
  @@index([city_id], map: "idx_activities_city")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admin_logs {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id       Int?     @db.UnsignedInt
  action_type   String   @db.VarChar(60)
  target_entity String   @db.VarChar(60)
  target_id     Int?     @db.UnsignedInt
  meta          Json?
  created_at    DateTime @default(now()) @db.Timestamp(0)
  users         users?   @relation(fields: [user_id], references: [id], map: "fk_logs_user")

  @@index([action_type], map: "idx_logs_action")
  @@index([user_id], map: "idx_logs_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model budgets {
  id                 Int      @id @default(autoincrement()) @db.UnsignedInt
  trip_id            Int      @unique(map: "trip_id") @db.UnsignedInt
  total_budget       Decimal  @default(0.00) @db.Decimal(10, 2)
  transport_cost     Decimal  @default(0.00) @db.Decimal(10, 2)
  accommodation_cost Decimal  @default(0.00) @db.Decimal(10, 2)
  activities_cost    Decimal  @default(0.00) @db.Decimal(10, 2)
  meals_cost         Decimal  @default(0.00) @db.Decimal(10, 2)
  misc_cost          Decimal  @default(0.00) @db.Decimal(10, 2)
  updated_at         DateTime @default(now()) @db.Timestamp(0)
  trips              trips    @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_budgets_trip")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cities {
  id                 Int                  @id @default(autoincrement()) @db.UnsignedInt
  name               String               @db.VarChar(100)
  country            String               @db.VarChar(100)
  region             String?              @db.VarChar(100)
  cost_index         Decimal              @default(1.00) @db.Decimal(5, 2)
  popularity_score   Int                  @default(0) @db.SmallInt
  cover_photo_url    String?              @db.VarChar(500)
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  activities         activities[]
  saved_destinations saved_destinations[]
  stops              stops[]

  @@index([country], map: "idx_cities_country")
  @@index([name], map: "idx_cities_name")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model notes {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  trip_id    Int      @db.UnsignedInt
  stop_id    Int?     @db.UnsignedInt
  content    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  stops      stops?   @relation(fields: [stop_id], references: [id], onDelete: Cascade, map: "fk_notes_stop")
  trips      trips    @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_notes_trip")

  @@index([stop_id], map: "idx_notes_stop")
  @@index([trip_id], map: "idx_notes_trip")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model packing_items {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  trip_id    Int      @db.UnsignedInt
  item_name  String   @db.VarChar(150)
  category   String   @default("general") @db.VarChar(60)
  is_packed  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  trips      trips    @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_packing_trip")

  @@index([trip_id], map: "idx_packing_trip")
}

model saved_destinations {
  id       Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id  Int      @db.UnsignedInt
  city_id  Int      @db.UnsignedInt
  saved_at DateTime @default(now()) @db.Timestamp(0)
  cities   cities   @relation(fields: [city_id], references: [id], onDelete: Cascade, map: "fk_saved_city")
  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_saved_user")

  @@unique([user_id, city_id], map: "uq_saved")
  @@index([city_id], map: "idx_saved_city")
  @@index([user_id], map: "idx_saved_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model shared_trips {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  trip_id      Int      @unique(map: "trip_id") @db.UnsignedInt
  public_token String   @unique(map: "public_token") @db.VarChar(64)
  is_active    Boolean  @default(true)
  view_count   Int      @default(0) @db.UnsignedInt
  created_at   DateTime @default(now()) @db.Timestamp(0)
  trips        trips    @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_shared_trip")

  @@index([public_token], map: "idx_shared_token")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model stop_activities {
  id             Int        @id @default(autoincrement()) @db.UnsignedInt
  stop_id        Int        @db.UnsignedInt
  activity_id    Int        @db.UnsignedInt
  scheduled_time DateTime?  @db.Time(0)
  actual_cost    Decimal?   @db.Decimal(10, 2)
  is_completed   Boolean    @default(false)
  created_at     DateTime   @default(now()) @db.Timestamp(0)
  activities     activities @relation(fields: [activity_id], references: [id], onDelete: Cascade, map: "fk_sa_activity")
  stops          stops      @relation(fields: [stop_id], references: [id], onDelete: Cascade, map: "fk_sa_stop")

  @@unique([stop_id, activity_id], map: "uq_stop_activity")
  @@index([activity_id], map: "idx_sa_activity")
  @@index([stop_id], map: "idx_sa_stop")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model stops {
  id              Int               @id @default(autoincrement()) @db.UnsignedInt
  trip_id         Int               @db.UnsignedInt
  city_id         Int               @db.UnsignedInt
  arrival_date    DateTime          @db.Date
  departure_date  DateTime          @db.Date
  order_index     Int               @default(0) @db.SmallInt
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  notes           notes[]
  stop_activities stop_activities[]
  cities          cities            @relation(fields: [city_id], references: [id], map: "fk_stops_city")
  trips           trips             @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_stops_trip")

  @@index([city_id], map: "idx_stops_city")
  @@index([trip_id], map: "idx_stops_trip")
}

model trips {
  id              Int             @id @default(autoincrement()) @db.UnsignedInt
  user_id         Int             @db.UnsignedInt
  name            String          @db.VarChar(150)
  description     String?         @db.Text
  cover_photo_url String?         @db.VarChar(500)
  start_date      DateTime        @db.Date
  end_date        DateTime        @db.Date
  status          trips_status    @default(draft)
  is_public       Boolean         @default(false)
  created_at      DateTime        @default(now()) @db.Timestamp(0)
  updated_at      DateTime        @default(now()) @db.Timestamp(0)
  budgets         budgets?
  notes           notes[]
  packing_items   packing_items[]
  shared_trips    shared_trips?
  stops           stops[]
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_trips_user")

  @@index([status], map: "idx_trips_status")
  @@index([user_id], map: "idx_trips_user")
}

model users {
  id                  Int                  @id @default(autoincrement()) @db.UnsignedInt
  name                String               @db.VarChar(100)
  email               String               @unique(map: "email") @db.VarChar(255)
  password_hash       String               @db.VarChar(255)
  profile_photo_url   String?              @db.VarChar(500)
  language_preference String               @default("en") @db.VarChar(10)
  role                users_role           @default(user)
  created_at          DateTime             @default(now()) @db.Timestamp(0)
  updated_at          DateTime             @default(now()) @db.Timestamp(0)
  admin_logs          admin_logs[]
  saved_destinations  saved_destinations[]
  trips               trips[]

  @@index([email], map: "idx_users_email")
}

enum users_role {
  user
  admin
}

enum trips_status {
  draft
  planned
  ongoing
  completed
}
